{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/45BitStudios/ConferenceKit/schema/conference.schema.json",
  "title": "ConferenceManifest",
  "type": "object",
  "required": ["conference"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "conference": { "$ref": "#/$defs/conference" },
    "theme": { "$ref": "#/$defs/theme" },
    "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
    "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } },
    "speakers": { "type": "array", "items": { "$ref": "#/$defs/speaker" } },
    "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
    "sponsors": { "type": "array", "items": { "$ref": "#/$defs/sponsor" } },
    "organizers": { "type": "array", "items": { "$ref": "#/$defs/organizer" } },
    "announcements": { "type": "array", "items": { "$ref": "#/$defs/announcement" } },
    "attendees": { "type": "array", "items": { "$ref": "#/$defs/attendee" } },
    "codeOfConduct": { "$ref": "#/$defs/conduct" },
    "wifi": { "$ref": "#/$defs/wifi" }
  },
  "$defs": {
    "conference": {
      "type": "object",
      "required": ["id", "name", "timezone", "startDate", "endDate"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "timezone": { "type": "string", "description": "IANA time zone, for example Asia/Singapore." },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "url": { "type": "string", "format": "uri" },
        "venue": { "$ref": "#/$defs/venue" }
      }
    },
    "venue": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "directions": { "type": "string" },
        "mapURL": { "type": "string", "format": "uri" }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "accent": { "type": "string" },
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "background": { "type": "string" },
        "surface": { "type": "string" },
        "onAccent": { "type": "string" },
        "preferredColorScheme": { "enum": ["system", "light", "dark"] }
      }
    },
    "track": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" }
      }
    },
    "room": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "floor": { "type": "string" },
        "capacity": { "type": "integer" }
      }
    },
    "speaker": {
      "type": "object",
      "required": ["id", "name", "bio"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "bio": { "type": "string" },
        "photoURL": { "type": ["string", "null"] },
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["platform", "url"],
            "properties": {
              "platform": { "enum": ["x", "github", "linkedin", "mastodon", "bluesky", "website", "youtube"] },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": ["id", "title", "synopsis", "startTime", "endTime"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "synopsis": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "speakerIDs": { "type": "array", "items": { "type": "string" } },
        "trackID": { "type": "string" },
        "roomID": { "type": "string" },
        "kind": { "enum": ["keynote", "talk", "workshop", "panel", "lightning", "breakout", "meal", "social", "other"] },
        "recordingURL": { "type": "string", "format": "uri" },
        "slidesURL": { "type": "string", "format": "uri" },
        "level": { "type": "string" }
      }
    },
    "sponsor": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tier": { "enum": ["title", "diamond", "gold", "silver", "community", "other"] },
        "url": { "type": "string", "format": "uri" },
        "logoURL": { "type": "string", "format": "uri" },
        "blurb": { "type": "string" }
      }
    },
    "organizer": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "bio": { "type": "string" }
      }
    },
    "attendee": {
      "type": "object",
      "required": ["id", "displayName"],
      "description": "Sensitive contact fields are private unless the matching privacy flag is true. discoverable defaults to false. The directory, vCard, QR code, and share payload omit anything that is not marked public. Organizers should leave a value out of the file when it is not public; the kit also strips it if the flag is off.",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "company": { "type": "string" },
        "bio": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["platform", "url"],
            "properties": {
              "platform": { "enum": ["x", "github", "linkedin", "mastodon", "bluesky", "website", "youtube"] },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "avatarAsset": { "type": "string", "description": "Image name in the host asset catalog." },
        "avatarURL": { "type": ["string", "null"], "format": "uri" },
        "ticket": { "$ref": "#/$defs/ticket" },
        "privacy": { "$ref": "#/$defs/attendeePrivacy" },
        "messagingConsent": { "type": "boolean", "default": false },
        "isCurrentUser": { "type": "boolean", "default": false, "description": "Seeds My Profile on this device when no local profile has been saved yet." }
      }
    },
    "attendeePrivacy": {
      "type": "object",
      "description": "Every flag defaults to false.",
      "properties": {
        "discoverable": { "type": "boolean", "default": false },
        "showsEmail": { "type": "boolean", "default": false },
        "showsPhone": { "type": "boolean", "default": false },
        "showsSocial": { "type": "boolean", "default": false }
      }
    },
    "ticket": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "announcement": {
      "type": "object",
      "required": ["id", "title", "body", "postedAt"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "postedAt": { "type": "string", "format": "date-time" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "conduct": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "contactEmail": { "type": "string" }
      }
    },
    "wifi": {
      "type": "object",
      "required": ["networkName"],
      "properties": {
        "networkName": { "type": "string" },
        "password": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
