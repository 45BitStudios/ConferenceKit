{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/45BitStudios/ConferenceKit/schema/conference.schema.json",
  "title": "ConferenceManifest",
  "type": "object",
  "required": ["conference"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "conference": { "$ref": "#/$defs/conference" },
    "theme": { "$ref": "#/$defs/theme" },
    "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
    "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } },
    "speakers": { "type": "array", "items": { "$ref": "#/$defs/speaker" } },
    "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
    "sponsors": { "type": "array", "items": { "$ref": "#/$defs/sponsor" } },
    "organizers": { "type": "array", "items": { "$ref": "#/$defs/organizer" } },
    "announcements": { "type": "array", "items": { "$ref": "#/$defs/announcement" } },
    "news": { "type": "array", "items": { "$ref": "#/$defs/newsItem" } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "pass": { "$ref": "#/$defs/pass" },
    "codeOfConduct": { "$ref": "#/$defs/conduct" },
    "wifi": { "$ref": "#/$defs/wifi" }
  },
  "$defs": {
    "conference": {
      "type": "object",
      "required": ["id", "name", "timezone", "startDate", "endDate"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "timezone": { "type": "string", "description": "IANA time zone, for example Asia/Singapore." },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "url": { "type": "string", "format": "uri" },
        "venue": { "$ref": "#/$defs/venue" }
      }
    },
    "venue": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "directions": { "type": "string" },
        "mapURL": { "type": "string", "format": "uri" }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "accent": { "type": "string" },
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "background": { "type": "string" },
        "surface": { "type": "string" },
        "onAccent": { "type": "string" },
        "preferredColorScheme": { "enum": ["system", "light", "dark"] }
      }
    },
    "track": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" }
      }
    },
    "room": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "floor": { "type": "string" },
        "capacity": { "type": "integer" }
      }
    },
    "speaker": {
      "type": "object",
      "required": ["id", "name", "bio"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "bio": { "type": "string" },
        "photoURL": { "type": ["string", "null"] },
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["platform", "url"],
            "properties": {
              "platform": { "enum": ["x", "github", "linkedin", "mastodon", "bluesky", "website", "youtube"] },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": ["id", "title", "synopsis", "startTime", "endTime"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "synopsis": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "speakerIDs": { "type": "array", "items": { "type": "string" } },
        "trackID": { "type": "string" },
        "roomID": { "type": "string" },
        "kind": { "enum": ["keynote", "talk", "workshop", "panel", "lightning", "breakout", "meal", "social", "other"] },
        "recordingURL": { "type": "string", "format": "uri" },
        "slidesURL": { "type": "string", "format": "uri" },
        "level": { "type": "string" }
      }
    },
    "sponsor": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tier": { "enum": ["title", "diamond", "gold", "silver", "community", "other"] },
        "url": { "type": "string", "format": "uri" },
        "logoURL": { "type": "string", "format": "uri" },
        "blurb": { "type": "string" }
      }
    },
    "organizer": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "bio": { "type": "string" }
      }
    },
    "announcement": {
      "type": "object",
      "required": ["id", "title", "body", "postedAt"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "postedAt": { "type": "string", "format": "date-time" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "newsItem": {
      "type": "object",
      "required": ["id", "title", "body", "publishedAt"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "linkURL": { "type": "string", "format": "uri" },
        "imageName": { "type": "string", "description": "SF Symbol name shown beside the item." },
        "isPinned": { "type": "boolean" },
        "announces": { "type": "boolean", "description": "When true, the app may post a local notification the first time this item is seen." }
      }
    },
    "resource": {
      "type": "object",
      "required": ["id", "title", "kind", "remoteURL", "category"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "kind": { "enum": ["pdf", "doc", "link"] },
        "remoteURL": { "type": "string", "format": "uri" },
        "localFilename": { "type": "string" },
        "fileSizeBytes": { "type": "integer" },
        "category": { "type": "string", "description": "Grouping key such as slides, map, or sponsor." }
      }
    },
    "pass": {
      "type": "object",
      "required": ["id", "attendeeName", "conferenceName", "seatOrTicketType", "barcodePayload", "relevantDate", "venueName"],
      "properties": {
        "id": { "type": "string" },
        "attendeeName": { "type": "string" },
        "conferenceName": { "type": "string" },
        "seatOrTicketType": { "type": "string" },
        "barcodePayload": { "type": "string" },
        "relevantDate": { "type": "string", "format": "date-time" },
        "venueName": { "type": "string" },
        "venueAddress": { "type": "string" }
      }
    },
    "conduct": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "contactEmail": { "type": "string" }
      }
    },
    "wifi": {
      "type": "object",
      "required": ["networkName"],
      "properties": {
        "networkName": { "type": "string" },
        "password": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
